# All settings are optional. The admin password is created in the browser on first run.
# PORT=3001
# HOST=127.0.0.1
# DATA_DIR=data
# Allow monitoring localhost / LAN addresses (SSRF guard blocks them by default)
# ALLOW_PRIVATE_TARGETS=false
# Set true when serving over HTTPS
# COOKIE_SECURE=false

# Copy every backup to a second place that survives this disk, e.g. a OneDrive / Google Drive folder.
# Backups contain master.key — use a private folder on an account with MFA.
# BACKUP_COPY_DIR=C:\Users\<you>\OneDrive\SENTINEL-backups

# Dead man's switch: ping URL from healthchecks.io (or similar). Pinged every 5 min; if pings stop
# (PC off, battery dead, SENTINEL hung) that service alerts you. Secret — keep it only here.
# HEARTBEAT_URL=https://hc-ping.com/<uuid>

# Optional: enables "AI summary" on incidents (Claude API, billed per use).
# ANTHROPIC_API_KEY=
